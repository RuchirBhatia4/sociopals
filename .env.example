# Copy to .env and fill in. Never commit .env.

# Clerk (auth) - dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Postgres 16 (local: run scripts/dev-db.sh, which serves on port 5433)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/sociopals"   # ./scripts/dev-db.sh

# UploadThing (server images, message attachments) - uploadthing.com/dashboard
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# LiveKit (voice/video channels) - cloud.livekit.io -> Settings -> Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Public URL of this app (Socket.io connects here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# openssl rand -base64 32
ENCRYPTION_KEY=
# GitHub OAuth app: callback URL = <site>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Code runner for C/C++/Java/Go/Rust… (see deploy/code-runner/README.md)
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
