# Sociopals production settings. Copy to deploy/app/.env on the server and fill in.
# Never commit the real file.

# ---- Your address ----
SITE_HOST=sociopals.ruchirbhatia.com
NEXT_PUBLIC_SITE_URL=https://sociopals.ruchirbhatia.com

# ---- Database (made up by setup.sh; keep them secret) ----
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- Clerk (sign-in). Use the PRODUCTION instance keys (pk_live_… / sk_live_…) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---- Uploads (same as your local .env) ----
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# ---- Calls (same as your local .env) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ---- Encrypts GitHub tokens and AI keys. New value for production: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Optional ----
# GitHub sign-in for project mode (a separate OAuth app with the production callback URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# AI summaries in Catch-up
ANTHROPIC_API_KEY=
# Code runner for C/C++/Java/Go/Rust… (deploy/code-runner)
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
